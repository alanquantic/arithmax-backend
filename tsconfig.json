{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "lib": ["esnext"],
    "typeRoots": ["./typings", "./node_modules/@types"]
  },
  "include": ["src"]
}
